rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function admin() {
   return request.auth != null &&
     request.auth.uid == 'REPLACE_FIREBASE_AUTH_ADMIN_UID';
  }
  function allowedCollection() {
   return true;
  }
  match /{collectionId}/{id} {
   allow get, list: if admin() &&
      collectionId in ['clients','projects','tasks','payments','renewals','notes'] &&
      resource.data.ownerId == request.auth.uid;
   allow create: if admin() &&
      collectionId in ['clients','projects','tasks','payments','renewals','notes'] &&
      request.resource.data.ownerId == request.auth.uid &&
      request.resource.data.keys().hasOnly(
       collectionId == 'clients' ? ['ownerId','createdAt','name','business','email','phone','domain'] :
       collectionId == 'projects' ? ['ownerId','createdAt','title','client','status','deadline'] :
       collectionId == 'tasks' ? ['ownerId','createdAt','title','client','status','due'] :
       collectionId == 'payments' ? ['ownerId','createdAt','client','description','amount','received'] :
       collectionId == 'renewals' ? ['ownerId','createdAt','client','service','provider','expiry'] :
       ['ownerId','createdAt','client','title','content']);
   allow update: if false;
   allow delete: if admin() &&
      collectionId in ['clients','projects','tasks','payments','renewals','notes'] &&
      resource.data.ownerId == request.auth.uid;
  }
 }
}
